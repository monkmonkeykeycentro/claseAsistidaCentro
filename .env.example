# Private server variables. Copy to .env.local; configure separately in Vercel.
# Never commit real credentials or private UID lists to this file.
MONGODB_URI="mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="clase_asistida"
FIREBASE_PROJECT_ID="your-firebase-project-id"
CMS_ADMIN_UIDS=""
API_PORT="3002"

# Public browser configuration: these values are visible in the built website.
# Firebase web keys identify the app; restrict them to Firebase APIs in Google Cloud.
VITE_DATA_BACKEND="mongodb"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_API_KEY="your-public-firebase-web-api-key"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Optional, for local emulator tests only. Never configure this in production.
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
