# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth web client ID used by the administrator's Drive integration.
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# MongoDB Atlas: server secrets, never prefix these variables with VITE_.
# Copy the Node.js URI from Atlas > Connect > Drivers. URL-encode the password.
MONGODB_URI="mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="clase_asistida"
API_PORT="3002"

# Enable only after importing and verifying the data. dev:mongo sets this itself.
# VITE_DATA_BACKEND="mongodb"

# Firebase Auth stays responsible for Google sign-in. By default, the server uses
# the project ID in firebase-applet-config.json. No service-account key is needed
# just to verify Firebase ID tokens.
# FIREBASE_PROJECT_ID="your-firebase-project-id"

# Local authentication tests only; never set this variable in production:
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
