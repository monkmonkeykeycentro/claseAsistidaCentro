rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'jmartineza@centro.edu.mx';
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrapAdmin()
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isPublished(data) {
      return data.status == 'published' && data.visible == true;
    }

    function publicModule(moduleId) {
      return isPublished(get(/databases/$(database)/documents/cms_modules/$(moduleId)).data);
    }

    function publicLesson(lessonId) {
      let lesson = get(/databases/$(database)/documents/cms_lessons/$(lessonId)).data;
      return isPublished(lesson) && publicModule(lesson.moduleId);
    }

    function publicSection(sectionId) {
      let section = get(/databases/$(database)/documents/cms_sections/$(sectionId)).data;
      return section.visible == true && publicLesson(section.lessonId);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId);
    }

    match /cms_modules/{moduleId} {
      allow read: if isAdmin() || isPublished(resource.data);
      allow write: if isAdmin() && isValidId(moduleId);
    }

    match /cms_lessons/{lessonId} {
      allow read: if isAdmin() || (isPublished(resource.data) && publicModule(resource.data.moduleId));
      allow write: if isAdmin() && isValidId(lessonId);
    }

    match /cms_sections/{sectionId} {
      allow read: if isAdmin() || (resource.data.visible == true && publicLesson(resource.data.lessonId));
      allow write: if isAdmin() && isValidId(sectionId);
    }

    match /cms_blocks/{blockId} {
      allow read: if isAdmin() || publicSection(resource.data.sectionId);
      allow write: if isAdmin() && isValidId(blockId);
    }

    match /cms_site_content/{contentKey} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(contentKey);
    }

    match /cms_media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(mediaId);
    }

    match /cms_revisions/{revisionId} {
      allow read, write: if isAdmin() && isValidId(revisionId);
    }

    // User profiles: each user can only read and write their own profile; admins can list and review
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;

      allow update: if (isOwner(userId) || isAdmin())
        && isValidId(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if isAdmin() && isValidId(userId);

      // User progress subcollection
      match /progress/{topicId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(topicId);
        allow list: if isOwner(userId) || isAdmin();

        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(topicId)
          && request.resource.data.userId == request.auth.uid;

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(topicId);
      }

      // Pilot exercise evidences subcollection
      match /pilot_evidences/{exerciseId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(exerciseId);
        allow list: if isOwner(userId) || isAdmin();

        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(exerciseId)
          && request.resource.data.userId == request.auth.uid;

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(exerciseId);
      }

      // Class designs subcollection for the Diseñador de Clases tool
      match /class_designs/{designId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(designId);
        allow list: if isOwner(userId) || isAdmin();

        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(designId)
          && request.resource.data.userId == request.auth.uid;

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(designId);
      }
    }
  }
}
