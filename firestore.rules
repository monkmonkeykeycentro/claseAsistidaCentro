rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Platform administrator verification (Bootstrapped email and /admins collection check)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jmartineza@centro.edu.mx' ||
        request.auth.token.email.matches('(?i)^jmartineza@centro\\.edu\\.mx$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin Users Directory
    match /admins/{adminId} {
      allow read: if isSignedIn() && isValidId(adminId);
      allow write: if isSignedIn() && (
        request.auth.token.email == 'jmartineza@centro.edu.mx' ||
        request.auth.token.email.matches('(?i)^jmartineza@centro\\.edu\\.mx$') ||
        isAdmin()
      ) && isValidId(adminId);
    }

    // CMS Modules
    match /cms_modules/{moduleId} {
      allow read: if isValidId(moduleId);
      allow create, update, delete: if isAdmin() && isValidId(moduleId);
    }

    // CMS Lessons
    match /cms_lessons/{lessonId} {
      allow read: if isValidId(lessonId);
      allow create, update, delete: if isAdmin() && isValidId(lessonId);
    }

    // CMS Sections
    match /cms_sections/{sectionId} {
      allow read: if isValidId(sectionId);
      allow create, update, delete: if isAdmin() && isValidId(sectionId);
    }

    // CMS Content Blocks
    match /cms_blocks/{blockId} {
      allow read: if isValidId(blockId);
      allow create, update, delete: if isAdmin() && isValidId(blockId);
    }

    // CMS Site General Content
    match /cms_site_content/{contentKey} {
      allow read: if isValidId(contentKey);
      allow write: if isAdmin() && isValidId(contentKey);
    }

    // CMS Media Resources
    match /cms_media/{mediaId} {
      allow read: if isValidId(mediaId);
      allow write: if isAdmin() && isValidId(mediaId);
    }

    // CMS Editorial Revisions & Backups
    match /cms_revisions/{revisionId} {
      allow read, write: if isAdmin() && isValidId(revisionId);
    }

    // User profiles: each user can only read and write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying across all users

      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;

      allow update: if (isOwner(userId) || isAdmin())
        && isValidId(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if isAdmin() && isValidId(userId);

      // User progress subcollection
      match /progress/{topicId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(topicId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(topicId)
          && request.resource.data.userId == request.auth.uid;

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(topicId);
      }
    }
  }
}
