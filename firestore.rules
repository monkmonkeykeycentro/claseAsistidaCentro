rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: each user can only read and write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying across all users

      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == resource.data.email; // Email cannot be changed maliciously

      allow delete: if false; // Do not allow deleting accounts from client

      // User progress subcollection
      match /progress/{topicId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(topicId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(topicId)
          && request.resource.data.userId == request.auth.uid;

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(topicId);
      }
    }
  }
}
